{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No ambient type packages, for the same reason `@whole/ocr` has none: this
    // package must not reach a global. In particular it must not reach a global
    // `fetch` — the transport is a parameter, which is what keeps every error
    // path (401, 429, timeout, malformed body) reachable from a two-line fake.
    "types": []
  },
  "include": ["./src/**/*.ts", "./vitest.config.ts"],
  "exclude": ["node_modules"]
}
