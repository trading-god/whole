{
  "name": "@whole/ocr-eval",
  "version": "0.0.0",
  "private": true,
  "description": "Node harness that drives and verifies whole's OCR semantic parser against recorded screenshots (regression evaluation).",
  "type": "module",
  "scripts": {
    "eval": "tsx src/run-eval.ts",
    "vision": "tsx src/vision.ts",
    "recognize": "tsx src/recognize.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@whole/ocr": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  }
}
