npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# OCR eval — real account screenshots are private. Only the recorded
# blocks.json + expected.json fixtures (no PII) are committed as regression data.
/packages/ocr-eval/samples/*/screenshot.*
# Compiled Apple Vision bridge — a local build artifact of
# vision/recognize-text.swift, rebuilt on demand by `pnpm eval:ocr:vision`.
/packages/ocr-eval/vision/.build/

# Coverage reports, at the root and in every workspace package — regenerated by
# the `test:*:coverage` scripts.
coverage/

# Claude Code. Only `.claude/skills/` and `settings.json` are committed;
# everything else under `.claude/` is per-machine runtime state. Default-deny
# rather than a list, so a state file a future release adds is ignored without
# an edit here — and committing something new under `.claude/` has to be
# deliberate (git refuses it by name and points at `-f`). It only started
# mattering once the vendored skills made `.claude/` a tracked directory that
# every contributor pulls — before that this was held back by a local
# `.git/info/exclude`, which never ships. `.claude/*`, not `.claude/`: git does
# not descend into an excluded directory, so the trailing-slash form would make
# the un-ignores below dead.
.claude/*
!.claude/skills/
!.claude/settings.json
