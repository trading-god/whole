# whole's OCR eval LLM annotation configuration
# (packages/ocr-eval/src/annotate.ts)
#
# Only needed when you want to use the LLM annotation helper
# (`pnpm eval:ocr:label`). These three variables are read by `annotate.ts` to
# call an OpenAI-compatible endpoint; without them the annotation command
# errors out.
#
# Real shell environment variables take precedence over this file (dotenv
# convention).
#
# Privacy: if samples/<slug>/screenshot.png exists, the screenshot is sent to
# the configured endpoint as base64 — screenshots are sensitive data, so only
# use a trusted endpoint (.env is gitignored).
#
# Copy this file to .env and fill it in (do not commit real keys; the
# .env.example template itself may be committed):
#   cp .env.example .env

# Base URL of the OpenAI-compatible API (default https://api.openai.com/v1;
# DeepSeek / internal gateways also work)
OPENAI_BASE_URL=

# API key for the OpenAI-compatible endpoint (required)
OPENAI_API_KEY=

# Model name (default gpt-4o; use a vision-capable model when screenshots are
# provided)
OPENAI_MODEL=
