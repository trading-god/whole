{
  "expo": {
    "name": "Whole",
    "slug": "whole",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "whole",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.whole.app"
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "package": "com.whole.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "en": "./config/locales/en.json",
      "zh-Hans": "./config/locales/zh-Hans.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 Whole 选择账户截图并识别账户信息。你确认后，Whole 也可删除用于识别的账户截图。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "允许 Whole 选择账户截图并识别账户信息。你确认后，Whole 也可删除用于识别的账户截图。",
          "savePhotosPermission": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 320
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "zh-Hans"]
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "173031dd-691d-4737-929e-0c713d62e3dc"
      }
    },
    "owner": "j4ck_w4n9"
  }
}
