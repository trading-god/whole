         const classEndRegex = /^}$/gm;
         const matches = [...appDelegateContents.matchAll(classEndRegex)];
         if (matches.length > 0) {
-            // Insert before the last closing brace (assuming it's the AppDelegate class)
-            const lastMatch = matches[matches.length - 1];
-            const insertPosition = lastMatch.index;
+            // Insert before the FIRST closing brace: that is the @main
+            // UIApplicationDelegate class the OS delivers the callback to.
+            // Expo SDK >= 52 templates append a ReactNativeDelegate class
+            // AFTER AppDelegate, so the LAST brace is that delegate's —
+            // inserting there puts the method on a class that never
+            // receives it, iOS never hands over the completion handler,
+            // and background-download relaunches are throttled.
+            const firstMatch = matches[0];
+            const insertPosition = firstMatch.index;
             appDelegateContents = appDelegateContents.slice(0, insertPosition) +
                 methodToAdd + '\n' +
                 appDelegateContents.slice(insertPosition);
