+  // PATCH(whole): extract the bundled model shards into filesDir before the
+  // JSI bindings install. llama.cpp can only load models from real paths, and
+  // Android APK assets are not filesystem paths — the shards are copied out
+  // once, here, so `initLlama` receives a filesDir path that already holds
+  // every shard (see whole's `assets/models/` and `plugins/with-whole-model`).
+  //
+  // "Once" means on the first `install()` of a fresh install, which is the
+  // app's first llama use — not at package-install time. That is why the copy
+  // is hopped off the calling thread below.
+  //
+  // Idempotent: an already-extracted shard is left alone, and a shard is only
+  // renamed into place once it is whole — an interrupted copy leaves no
+  // truncated destination, and its `.part` is cleaned up so a retry does not
+  // start out of disk.
+  //
+  // "Already extracted" is judged by NAME, not by content: an asset's
+  // uncompressed length is not readable here without reading the asset. That
+  // is safe only because the shard names carry the quantization
+  // (`gemma-4-E2B-it-Q4_K_M.gguf-00001-of-00003.gguf`), so a different model
+  // is a different file name and does get extracted. Shipping DIFFERENT BYTES
+  // under the SAME name would leave the stale copy in place forever — so a
+  // rebuilt GGUF must be renamed, not silently swapped.
+  private static void extractWholeModelShards(ReactApplicationContext context) {
+    final String assetDir = "whole_models";
+    try {
+      String[] names = context.getAssets().list(assetDir);
+      if (names == null || names.length == 0) {
+        return;
+      }
+      File destDir = new File(context.getFilesDir(), assetDir);
+      if (!destDir.exists() && !destDir.mkdirs()) {
+        return;
+      }
+      // A previous quant's shards first. The names carry the quantization, so
+      // an app update that changes the model extracts a whole new set — and
+      // without this the old ~3 GB stays in filesDir for good, reclaimable
+      // only by clearing app data.
+      List<String> current = Arrays.asList(names);
+      File[] existing = destDir.listFiles();
+      if (existing != null) {
+        for (File file : existing) {
+          if (!current.contains(file.getName())) {
+            file.delete();
+          }
+        }
+      }
+      for (String name : names) {
+        File dest = new File(destDir, name);
+        if (dest.exists() && dest.length() > 0) {
+          continue;
+        }
+        File partial = new File(destDir, name + ".part");
+        try {
+          try (InputStream in = context.getAssets().open(assetDir + "/" + name);
+               OutputStream out = new FileOutputStream(partial)) {
+            byte[] buffer = new byte[1 << 20];
+            int read;
+            // `!= -1`, not `> 0`: -1 is the only end-of-stream signal, and a
+            // legal 0-length read would otherwise end the copy early and
+            // rename a TRUNCATED shard into place as a finished one. Nothing
+            // afterwards re-extracts it, so the install would be stuck with a
+            // corrupt model for good.
+            while ((read = in.read(buffer)) != -1) {
+              out.write(buffer, 0, read);
+            }
+          }
+          if (!partial.renameTo(dest)) {
+            partial.delete();
+          }
+        } catch (IOException e) {
+          // Do not leave a partial behind: it can be most of a shard, and the
+          // retry on the next launch needs that space more than this one did.
+          partial.delete();
+          throw e;
+        }
+      }
+    } catch (IOException ignored) {
+      // Best effort: the load in `initLlama` reports the missing file.
+    }
+  }
