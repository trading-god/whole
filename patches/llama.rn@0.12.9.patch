   @Override
   public void install(Promise promise) {
+    // PATCH(whole): the extraction above is a multi-gigabyte file copy, and
+    // this method body runs on the JS thread (a TurboModule method is invoked
+    // synchronously from JS). Doing it inline froze the UI for the length of
+    // the copy — an ANR, not a spinner. So it runs on a worker thread, and
+    // everything after it is hopped BACK: the JS context pointer and the JSI
+    // bindings belong to the JS thread and may not be touched from another.
+    //
+    // Everything on that thread is wrapped: an exception escaping it would kill
+    // the thread before the hop back, leaving `install()`'s Promise unsettled
+    // forever — and the JS side awaits it, so a recognition would hang on a
+    // spinner with no error and no way out short of killing the app.
+    new Thread(
+      () -> {
+        try {
+          extractWholeModelShards(context);
+          context.runOnJSQueueThread(() -> installJsi(promise));
+        } catch (Throwable e) {
+          promise.reject("whole_model_extract_failed", e);
+        }
+      },
+      "whole-model-extract"
+    ).start();
+  }
