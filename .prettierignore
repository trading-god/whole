# pnpm
pnpm-lock.yaml
pnpm-workspace.yaml

# Vendored agent skills: upstream copies recorded in `skills-lock.json`, not
# hand-edited source. Formatting them would rewrite bytes this repo does not
# own, turning every re-vendor into a conflict against Prettier's reflow. The
# entry is load-bearing, not tidiness: Prettier does descend into dot
# directories, and 38 of the 55 vendored files fail `format:check` as upstream
# ships them.
.claude/skills/

# OCR eval samples — captured OCR output (blocks.json), gold expectations
# (expected.json), and derived debugging artifacts (trace.json) are recorded
# data, not hand-edited source.
packages/ocr-eval/samples/*/blocks.json
packages/ocr-eval/samples/*/expected.json
packages/ocr-eval/samples/*/trace.json

# Coverage reports: generated HTML, and the v8 reporter's markup is not
# well-formed enough for Prettier to parse.
coverage/
